// Skema Prisma — EduSaaS
// ---------------------------------------------------------------------------
// Fase F0 bagian 1: model GLOBAL (tanpa school_id): schools, plans, users.
// Fase F0 bagian 2: model tenant PERTAMA (memberships) sebagai bukti mekanisme
// isolasi. Model tenant berikutnya menyusul bersama modulnya, masing-masing
// wajib punya field schoolId, @@index diawali schoolId, dan policy RLS.
//
// Konvensi (PRD §7):
//   - Primary key UUID v7, kolom timestamptz (waktu disimpan UTC)
//   - Nama model PascalCase -> tabel snake_case lewat @@map
//   - Kolom snake_case lewat @map
//   - Semua tabel punya created_at / updated_at / deleted_at
//
// Prisma 7: `url` TIDAK ditulis di sini, tapi di prisma.config.ts.
//
// Catatan UUID v7: `@default(uuid(7))` digerakkan oleh Prisma Client, bukan oleh
// database. Kolom `id` karena itu tidak punya DEFAULT di SQL — setiap INSERT
// harus lewat Prisma Client (atau SQL yang menyediakan id sendiri).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SchoolLevel {
  SD
  SMP
  SMA
  SMK
  MI
  MTS
  MA

  @@map("school_level")
}

enum SchoolStatus {
  trial
  active
  grace
  readonly
  suspended

  @@map("school_status")
}

enum MembershipRole {
  school_admin
  teacher
  student
  parent

  @@map("membership_role")
}

enum SubscriptionStatus {
  trial
  active
  expired
  canceled

  @@map("subscription_status")
}

enum SubjectGroup {
  umum
  produktif
  muatan_lokal

  @@map("subject_group")
}

enum MembershipStatus {
  active
  inactive
  pending

  @@map("membership_status")
}

/// Jenis kelamin (PRD §7). Nilai L/P mengikuti format data sekolah di Indonesia.
enum Gender {
  L
  P

  @@map("gender")
}

/// Objek yang diimpor dari berkas Excel (OB-02).
enum ImportKind {
  teachers
  students

  @@map("import_kind")
}

enum ImportStatus {
  queued
  processing
  done
  failed

  @@map("import_status")
}

/// Tenant utama. Diidentifikasi lewat subdomain -> schools.slug.
model School {
  id               String       @id @default(uuid(7)) @db.Uuid
  slug             String       @unique @db.VarChar(63)
  npsn             String?      @unique @db.VarChar(16)
  name             String       @db.VarChar(191)
  level            SchoolLevel
  status           SchoolStatus @default(trial)
  logoUrl          String?      @map("logo_url") @db.VarChar(500)
  timezone         String       @default("Asia/Jakarta") @db.VarChar(64)
  /// Terisi saat admin menyelesaikan wizard setup pertama (OB-01).
  setupCompletedAt DateTime?    @map("setup_completed_at") @db.Timestamptz(6)

  memberships   Membership[]
  subscriptions Subscription[]
  academicYears AcademicYear[]
  semesters     Semester[]
  majors        Major[]
  classrooms    Classroom[]
  subjects      Subject[]
  teachers      Teacher[]
  students      Student[]
  enrollments   Enrollment[]
  courses       Course[]
  parentLinks   ParentLink[]
  importBatches ImportBatch[]
  importErrors  ImportError[]
  auditLogs     AuditLog[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([status])
  @@map("schools")
}

/// Paket langganan. Semula diaktifkan manual oleh Super Admin (AGENTS.md aturan 10).
model Plan {
  id            String @id @default(uuid(7)) @db.Uuid
  code          String @unique @db.VarChar(32)
  name          String @db.VarChar(100)
  priceSemester Int    @map("price_semester")
  priceYear     Int    @map("price_year")
  maxStudents   Int    @map("max_students")
  maxStorageGb  Int    @map("max_storage_gb")
  features      Json   @default("{}") @db.JsonB

  subscriptions Subscription[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@map("plans")
}

/// Identitas global (bukan milik satu sekolah). Relasi ke sekolah lewat `memberships`.
/// Dipakai Better Auth sebagai model `user` (kolom `email_verified`, `image`).
model User {
  id            String  @id @default(uuid(7)) @db.Uuid
  email         String  @unique @db.VarChar(320)
  name          String  @db.VarChar(191)
  image         String? @db.VarChar(500)
  emailVerified Boolean @default(false) @map("email_verified")

  accounts        Account[]
  sessions        Session[]
  memberships     Membership[]
  platformAdmin   PlatformAdmin?
  teacherProfiles Teacher[]
  studentProfiles Student[]
  parentLinks     ParentLink[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@map("users")
}

/// Sesi login Better Auth. Cookie-nya host-only, jadi sesi di
/// `sekolah-a.edusaas.id` tidak berlaku di `sekolah-b.edusaas.id`.
model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address") @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  userId    String   @map("user_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Kredensial dan akun pihak ketiga milik Better Auth.
/// Untuk email + password, `provider_id` = "credential" dan `password` berisi hash.
model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String    @map("account_id") @db.VarChar(191)
  providerId            String    @map("provider_id") @db.VarChar(191)
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?   @db.Text
  password              String?   @db.VarChar(255)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// Token verifikasi email / lupa sandi milik Better Auth.
model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String   @db.VarChar(320)
  value      String   @db.Text
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("verifications")
}

/// Model tenant pertama (F0). Satu user bisa punya peran berbeda di sekolah berbeda.
/// Wajib diakses lewat `tenantDb(schoolId)` — lihat src/db/tenant.ts.
model Membership {
  id       String           @id @default(uuid(7)) @db.Uuid
  schoolId String           @map("school_id") @db.Uuid
  userId   String           @map("user_id") @db.Uuid
  role     MembershipRole
  status   MembershipStatus @default(active)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([schoolId, userId])
  @@index([schoolId, role])
  @@index([schoolId, userId])
  @@map("memberships")
}

/// Super Admin platform. Hanya baris di tabel ini yang boleh membuka dashboard
/// app.<domain>. Sengaja tabel terpisah (bukan kolom di `users`) supaya tidak
/// pernah ikut terisi lewat input pendaftaran Better Auth.
model PlatformAdmin {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("platform_admins")
}

/// Langganan sekolah. Model tenant: sekolah hanya melihat miliknya; Super Admin
/// mengelola lewat `platformDb()` (src/db/platform.ts). Riwayat disimpan:
/// langganan terbaru (createdAt) yang berstatus trial/active adalah yang berlaku.
model Subscription {
  id          String             @id @default(uuid(7)) @db.Uuid
  schoolId    String             @map("school_id") @db.Uuid
  planId      String             @map("plan_id") @db.Uuid
  status      SubscriptionStatus
  periodStart DateTime           @map("period_start") @db.Timestamptz(6)
  periodEnd   DateTime           @map("period_end") @db.Timestamptz(6)
  trialEndsAt DateTime?          @map("trial_ends_at") @db.Timestamptz(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([schoolId, status])
  @@index([schoolId, createdAt])
  @@index([periodEnd])
  @@map("subscriptions")
}

/// Penghitung pembatasan laju (src/lib/rate-limit.ts). Bukan model tenant:
/// kunci berisi bucket + alamat klien, jadi tidak ada schoolId dan tidak ada RLS.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime @map("reset_at") @db.Timestamptz(6)

  @@index([resetAt])
  @@map("rate_limits")
}

/// Pesan dari form kontak/demo di landing (LP-05). Data global, bukan milik sekolah.
model ContactRequest {
  id         String  @id @default(uuid(7)) @db.Uuid
  name       String  @db.VarChar(100)
  email      String  @db.VarChar(254)
  schoolName String? @map("school_name") @db.VarChar(150)
  message    String  @db.VarChar(2000)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("contact_requests")
}

/// Data master akademik (F2, OB-01). Semua model tenant: wajib lewat tenantDb().
/// Tahun ajaran, mis. "2026/2027". Hanya satu yang aktif per sekolah (indeks parsial di migrasi).
model AcademicYear {
  id        String   @id @default(uuid(7)) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  name      String   @db.VarChar(32)
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  isActive  Boolean  @default(false) @map("is_active")

  school    School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  semesters Semester[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([schoolId, name])
  @@index([schoolId, isActive])
  @@map("academic_years")
}

/// Semester ("Ganjil"/"Genap") milik satu tahun ajaran. Hanya satu yang aktif per sekolah.
model Semester {
  id             String   @id @default(uuid(7)) @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  name           String   @db.VarChar(32)
  startDate      DateTime @map("start_date") @db.Date
  endDate        DateTime @map("end_date") @db.Date
  isActive       Boolean  @default(false) @map("is_active")

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classrooms   Classroom[]
  courses      Course[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([schoolId, academicYearId, name])
  @@index([schoolId, isActive])
  @@index([schoolId, academicYearId])
  @@map("semesters")
}

/// Kompetensi keahlian (khusus SMK).
model Major {
  id       String @id @default(uuid(7)) @db.Uuid
  schoolId String @map("school_id") @db.Uuid
  code     String @db.VarChar(16)
  name     String @db.VarChar(120)

  school     School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classrooms Classroom[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([schoolId, code])
  @@map("majors")
}

/// Rombel (rombongan belajar) per semester. Wali kelas diisi di OB-03.
model Classroom {
  id                String  @id @default(uuid(7)) @db.Uuid
  schoolId          String  @map("school_id") @db.Uuid
  semesterId        String  @map("semester_id") @db.Uuid
  grade             Int     @db.SmallInt
  majorId           String? @map("major_id") @db.Uuid
  name              String  @db.VarChar(64)
  /// Wali kelas. Satu guru hanya boleh menjadi wali satu rombel per semester;
  /// dijamin indeks unik parsial di migrasi (semua kolom ada di baris ini).
  homeroomTeacherId String? @map("homeroom_teacher_id") @db.Uuid

  school          School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  semester        Semester     @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  major           Major?       @relation(fields: [majorId], references: [id], onDelete: SetNull)
  homeroomTeacher Teacher?     @relation(fields: [homeroomTeacherId], references: [id], onDelete: SetNull)
  enrollments     Enrollment[]
  courses         Course[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([schoolId, semesterId])
  @@index([schoolId, majorId])
  @@map("classrooms")
}

/// Mata pelajaran.
model Subject {
  id       String       @id @default(uuid(7)) @db.Uuid
  schoolId String       @map("school_id") @db.Uuid
  code     String       @db.VarChar(16)
  name     String       @db.VarChar(120)
  group    SubjectGroup @default(umum)

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  courses Course[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([schoolId, code])
  @@map("subjects")
}

/// Profil guru sekolah (OB-02). Nama & email diambil dari `users` (tabel
/// global) agar tidak diduplikasi; yang disimpan di sini adalah identitas
/// sekolah: kode guru, NIP/NUPTK. `code` wajib karena sebagian guru honor
/// tidak punya NIP, sementara OB-03 butuh kunci unik yang stabil.
model Teacher {
  id       String  @id @default(uuid(7)) @db.Uuid
  schoolId String  @map("school_id") @db.Uuid
  userId   String  @map("user_id") @db.Uuid
  code     String  @db.VarChar(32)
  nip      String? @db.VarChar(18)
  nuptk    String? @db.VarChar(32)
  gender   Gender?
  phone    String? @db.VarChar(20)

  school    School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses   Course[]
  homerooms Classroom[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([schoolId, userId])
  @@index([schoolId])
  @@map("teachers")
}

/// Profil siswa sekolah (OB-02). NIS adalah identitas sekolah dan unik per
/// sekolah; NISN opsional (sebagian sekolah belum punya). Login siswa memakai
/// NIS + PIN (US-01), jadi impor tidak membuat akun sandi untuk siswa.
model Student {
  id       String  @id @default(uuid(7)) @db.Uuid
  schoolId String  @map("school_id") @db.Uuid
  userId   String  @map("user_id") @db.Uuid
  nis      String  @db.VarChar(32)
  nisn     String? @db.VarChar(12)
  gender   Gender?

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  parentLinks ParentLink[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([schoolId, userId])
  @@index([schoolId])
  @@map("students")
}

/// Penempatan siswa di rombel pada satu semester (OB-02 lewat kolom "Rombel").
model Enrollment {
  id          String @id @default(uuid(7)) @db.Uuid
  schoolId    String @map("school_id") @db.Uuid
  studentId   String @map("student_id") @db.Uuid
  classroomId String @map("classroom_id") @db.Uuid

  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([schoolId, classroomId, studentId])
  @@index([schoolId, studentId])
  @@index([schoolId, classroomId])
  @@map("enrollments")
}

/// Undangan dan tautan orang tua <-> siswa (OB-05). Satu baris = satu undangan;
/// setelah kode ditukar, `parent_user_id` terisi dan baris menjadi tautan.
/// Kode asli TIDAK disimpan, hanya hash SHA-256 (`code_hash`), jadi hanya
/// terlihat sekali saat dibuat. Unik per orang tua per siswa selama belum
/// dicabut dijamin indeks unik parsial di migrasi.
model ParentLink {
  id            String    @id @default(uuid(7)) @db.Uuid
  schoolId      String    @map("school_id") @db.Uuid
  studentId     String    @map("student_id") @db.Uuid
  parentUserId  String?   @map("parent_user_id") @db.Uuid
  codeHash      String    @map("code_hash") @db.VarChar(64)
  codeExpiresAt DateTime  @map("code_expires_at") @db.Timestamptz(6)
  linkedAt      DateTime? @map("linked_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)

  school     School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parentUser User?   @relation(fields: [parentUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([schoolId, codeHash])
  @@index([schoolId, studentId])
  @@index([schoolId, parentUserId])
  @@map("parent_links")
}

/// Kelas pembelajaran (OB-03): satu kombinasi rombel x mapel x guru pada satu
/// semester. `semester_id` memang bisa diturunkan dari rombel, tapi PRD §7
/// menyebutnya eksplisit dan service memakainya sebagai pemeriksaan integritas
/// (rombel harus berada pada semester yang sama).
///
/// Unik per (rombel, mapel, semester) selama belum dihapus — dijamin indeks unik
/// parsial `courses_classroom_subject_semester_active_idx` di migrasi, jadi
/// indeks ini sengaja TIDAK ditulis sebagai @@unique.
model Course {
  id          String @id @default(uuid(7)) @db.Uuid
  schoolId    String @map("school_id") @db.Uuid
  classroomId String @map("classroom_id") @db.Uuid
  subjectId   String @map("subject_id") @db.Uuid
  teacherId   String @map("teacher_id") @db.Uuid
  semesterId  String @map("semester_id") @db.Uuid

  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  subject   Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  semester  Semester  @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([schoolId, semesterId])
  @@index([schoolId, classroomId])
  @@index([schoolId, subjectId])
  @@index([schoolId, teacherId])
  @@map("courses")
}

/// Satu unggahan impor Excel beserta hasilnya (OB-02). Status `queued`
/// menunggu worker pg-boss; `processing` sedang dibaca; `done` selesai
/// (sebagian baris boleh gagal); `failed` berkas tidak bisa diproses sama sekali.
model ImportBatch {
  id           String       @id @default(uuid(7)) @db.Uuid
  schoolId     String       @map("school_id") @db.Uuid
  kind         ImportKind
  status       ImportStatus @default(queued)
  fileName     String       @map("file_name") @db.VarChar(191)
  totalRows    Int          @default(0) @map("total_rows")
  importedRows Int          @default(0) @map("imported_rows")
  failedRows   Int          @default(0) @map("failed_rows")
  errorMessage String?      @map("error_message") @db.VarChar(500)
  createdBy    String       @map("created_by") @db.Uuid
  startedAt    DateTime?    @map("started_at") @db.Timestamptz(6)
  finishedAt   DateTime?    @map("finished_at") @db.Timestamptz(6)

  school School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  errors ImportError[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([schoolId, createdAt])
  @@map("import_batches")
}

/// Satu kesalahan pada satu baris berkas impor (rowNumber 0 = kesalahan berkas).
/// Disimpan supaya laporan error bisa diunduh ulang kapan saja tanpa menyimpan
/// berkas sumber.
model ImportError {
  id        String  @id @default(uuid(7)) @db.Uuid
  schoolId  String  @map("school_id") @db.Uuid
  batchId   String  @map("batch_id") @db.Uuid
  rowNumber Int     @map("row_number")
  column    String? @db.VarChar(32)
  value     String? @db.VarChar(191)
  message   String  @db.VarChar(300)

  batch  ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  school School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([schoolId, batchId])
  @@map("import_errors")
}

/// Log audit (US-04): hanya ditambah, tidak pernah diubah atau dihapus (hak
/// UPDATE/DELETE dicabut di migrasi). Ditulis lewat `recordAudit()` dalam
/// transaksi yang sama dengan aksinya. `actorName` adalah salinan saat aksi
/// terjadi supaya log tetap terbaca walau akun berubah. `before`/`after`
/// hanya berisi field relevan, tanpa sandi, hash, atau kode undangan.
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorName   String   @map("actor_name") @db.VarChar(191)
  /// `platform_admin` atau peran sekolah (school_admin, teacher, ...).
  actorRole   String   @map("actor_role") @db.VarChar(32)
  /// Format `<modul>.<aksi>`, mis. `subscription.activate`.
  action      String   @db.VarChar(64)
  entity      String   @db.VarChar(64)
  entityId    String?  @map("entity_id") @db.VarChar(64)
  before      Json?
  after       Json?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([schoolId, createdAt])
  @@index([schoolId, action, createdAt])
  @@map("audit_logs")
}
