# Konfigurasi contoh. Salin ke .env lalu sesuaikan passwordnya:
#   Copy-Item .env.example .env

# PostgreSQL lokal (Windows, tanpa Docker). Dipakai Prisma CLI untuk migrasi
# dan Prisma Client untuk query.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edusaas?schema=public"

# Opsional. Hanya perlu diisi bila user PostgreSQL tidak punya hak CREATEDB,
# sehingga Prisma tidak dapat membuat shadow database otomatis untuk
# `pnpm db:migrate`. Database shadow harus kosong dan dibuat manual.
# SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edusaas_shadow?schema=public"