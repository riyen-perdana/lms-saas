# Konfigurasi contoh. Salin ke .env lalu sesuaikan passwordnya:
#   Copy-Item .env.example .env

# PostgreSQL lokal (Windows, tanpa Docker). Dipakai Prisma CLI untuk migrasi
# dan Prisma Client untuk query.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edusaas?schema=public"

# Dipakai aplikasi dan test (src/db/client.ts). User perannya NON-superuser:
# PostgreSQL selalu membiarkan superuser melewati Row Level Security, jadi RLS
# hanya menahan kebocoran antar sekolah bila query tidak memakai user ini.
# User-nya dibuat migrasi 20261014090800_rls_memberships.
DATABASE_APP_URL="postgresql://edusaas_app:edusaas_dev@localhost:5432/edusaas?schema=public"

# Opsional. Hanya perlu diisi bila user PostgreSQL tidak punya hak CREATEDB,
# sehingga Prisma tidak dapat membuat shadow database otomatis untuk
# `pnpm db:migrate`. Database shadow harus kosong dan dibuat manual.
# SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edusaas_shadow?schema=public"

# Better Auth. Buat rahasia acak minimal 32 karakter:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="ganti-dengan-rahasia-acak-minimal-32-karakter"

# Opsional (produksi). Domain utama tanpa protokol; subdomain sekolah ikut
# diizinkan sebagai host Better Auth.
# APP_DOMAIN="edusaas.id"


# Pengiriman email. "console" (default di development) mencetak email ke konsol
# dan menyimpannya di .email-outbox/ — tanpa akun penyedia. Test memakai "memory".
# Produksi WAJIB mengisi ini dengan driver penyedia email yang sudah ditambahkan
# di src/lib/email/index.ts.
# EMAIL_DRIVER="console"

# Batas pendaftaran sekolah per IP per jam (default 5). Naikkan hanya untuk dev/E2E.
# REGISTER_RATE_LIMIT="5"

# Alamat penerima notifikasi pesan form kontak (opsional; pesan tetap disimpan di database).
# CONTACT_EMAIL="halo@edusaas.id"
# CONTACT_RATE_LIMIT="5"   # batas pesan kontak per IP per jam; naikkan hanya untuk dev/E2E

# Penyimpanan file. "local" (default di development) menyimpan ke folder STORAGE_DIR
# (default .storage/). Produksi WAJIB mengisi STORAGE_DRIVER dengan driver object
# storage yang sudah ditambahkan di src/lib/storage/index.ts.
# STORAGE_DRIVER="local"
# STORAGE_DIR=".storage"
